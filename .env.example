# Copy to .env and fill in. .env is git-ignored; this file is not, so never put
# a real token here.
#
# Read by the scripts in tools/. Nothing here reaches the published site: the
# site gets ANALYTICS_ENDPOINT from a GitHub repository variable at build time,
# and never sees STATS_TOKEN at all.

# Where the page counter lives. Printed by `wrangler deploy`.
ANALYTICS_ENDPOINT=https://dartway-analytics.dartway.workers.dev

# Password for reading /stats. Generate one with `npm run token:new`, then push
# it to the worker with `npm run worker:secret`. Both sides must match.
STATS_TOKEN=
